;;; agent-dash-backup-test.el --- Hub backup tests -*- lexical-binding: t; -*-
;;; Code:
(require 'ert)
(require 'agent-dash)

(ert-deftest agent-dash-backup-real-hub-selection-fold-and-filter ()
  (let ((agent-dash-hub--sources (make-hash-table))
        (agent-dash-backends '(codex pi dsh claude hermes)))
    (dolist (backend agent-dash-backends)
      (puthash backend (list :status 'ok :rows
                             (list (list :backend backend :id (symbol-name backend)
                                         :key (format "%s:%s" backend backend)
                                         :root (if (eq backend 'hermes) "/other" "/project"))))
               agent-dash-hub--sources))
    (with-temp-buffer
      (agent-dash-hub-mode)
      (setq agent-dash-hub--project "/project" agent-dash-hub--grouping 'project)
      (puthash "/project" t agent-dash-hub--collapsed)
      (agent-dash-hub--render)
      (call-interactively (lookup-key agent-dash-hub-mode-map "M"))
      (should (= 4 (length (agent-dash-hub--backup-rows t))))
      (should-not (gethash "hermes:hermes" agent-dash-hub--selected))
      (should (eq (lookup-key agent-dash-hub-mode-map "B") #'agent-dash-hub-backup-menu)))))

(ert-deftest agent-dash-backup-export-explicit-unsupported-choice ()
  (let ((rows '((:backend codex :id "a" :key "codex:a")
                (:backend pi :id "b" :key "pi:b")
                (:backend dsh :id "c" :key "dsh:c")
                (:backend claude :id "d" :key "claude:d")
                (:backend hermes :id "e" :key "hermes:e"))) prompt args)
    (cl-letf (((symbol-function 'agent-dash-hub--backup-rows) (lambda (_) rows))
              ((symbol-function 'yes-or-no-p) (lambda (p) (setq prompt p) t))
              ((symbol-function 'read-directory-name) (lambda (&rest _) temporary-file-directory))
              ((symbol-function 'agent-dash-hub--backup-homes) (lambda (_) nil))
              ((symbol-function 'agent-dash-hub--backup-run) (lambda (a _done) (setq args a))))
      (agent-dash-hub-backup-export-selected)
      (should (string-match-p (rx string-start "agent-dash-backup-" (= 15 digit) ".zip" string-end)
                              (file-name-nondirectory (caddr args))))
      (should (equal (file-name-directory (caddr args)) temporary-file-directory))
      (should (string-search "claude 1" prompt))
      (should-not (string-search "hermes 1" prompt))
      (dolist (key '("codex:a" "pi:b" "dsh:c" "hermes:e")) (should (member key args)))
      (should-not (member "claude:d" args)))))

(ert-deftest agent-dash-backup-import-preview-and-refresh ()
  (let (calls report refreshed)
    (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) "/tmp/fixture.zip"))
              ((symbol-function 'agent-dash-hub--backup-homes) (lambda (_) '("--home" "codex" "/tmp/codex")))
              ((symbol-function 'agent-dash-hub--backup-maps) (lambda () nil))
              ((symbol-function 'agent-dash-hub--backup-active-ids) (lambda () nil))
              ((symbol-function 'agent-dash-holder-alive-p) (lambda (_) nil))
              ((symbol-function 'agent-dash-hub--reload-after-conversion) (lambda (backend &rest _) (push backend refreshed)))
              ((symbol-function 'display-buffer) (lambda (buffer &rest _) (setq report buffer)))
              ((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
              ((symbol-function 'agent-dash-hub--backup-run)
               (lambda (args done)
                 (push args calls)
                 (funcall done (agent-dash-json-read
                                (cond ((equal (car args) "inspect") "{\"backends\":[\"hermes\"]}")
                                      ((equal (car args) "preview")
                                       "{\"backends\":{\"hermes\":{\"warnings\":[\"missing parent\"]}},\"preview_token\":\"token\",\"sessions\":[{\"backend\":\"hermes\",\"id\":\"a\",\"action\":\"overwrite\",\"path\":\"/tmp/target\"}]}")
                                      (t "{\"affected_backends\":[\"hermes\",\"dsh\"],\"backends\":{\"hermes\":{\"rollback_archive_path\":\"/tmp/rollback.zip\"}}}"))) nil))))
      (unwind-protect
          (progn
            (agent-dash-hub-backup-import)
            (should (= 3 (length calls)))
            (should (member "token" (car calls)))
            (should (equal refreshed '(hermes)))
            (with-current-buffer report
              (should (string-search "覆盖 1" (buffer-string)))
              (should (string-search "hermes 提示：missing parent" (buffer-string)))
              (should (string-search "重新启动 Host" (buffer-string)))
              (goto-char (point-min))
              (search-forward "/tmp/rollback.zip")
              (should (button-at (1- (point))))))
        (when (buffer-live-p report) (kill-buffer report))))))

(ert-deftest agent-dash-backup-active-ids-include-all-backends ()
  (let ((agent-dash-hub--sources (make-hash-table))
        (agent-dash--sessions nil))
    (dolist (backend '(codex pi dsh hermes))
      (puthash backend (list :rows (list (list :backend backend :id "same" :running t)))
               agent-dash-hub--sources))
    (should (equal (agent-dash-hub--backup-active-ids)
                   '("codex:same" "dsh:same" "hermes:same" "pi:same")))))

(ert-deftest agent-dash-backup-failed-cli-reports-stderr ()
  (let (done failure (deadline (+ (float-time) 10)))
    (agent-dash-hub--backup-run
     '("export" "--output" "/tmp/unused.zip" "--session" "unknown:test")
     (lambda (_reply error) (setq done t failure error)))
    (while (and (not done) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should (stringp failure))
    (should (string-search "unknown" failure))))

(ert-deftest agent-dash-backup-maps-normalize-picked-directories ()
  (let ((answers '(t nil)) (directories (list "/a/source/" temporary-file-directory)))
    (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) (pop answers)))
              ((symbol-function 'read-directory-name) (lambda (&rest _) (pop directories))))
      (should (equal (agent-dash-hub--backup-maps)
                     (list "--map" "/a/source" (directory-file-name temporary-file-directory)))))))

(ert-deftest agent-dash-backup-report-keeps-all-backend-notices ()
  (let* ((reply (agent-dash-json-read
                 "{\"backends\":{\"dsh\":{\"warnings\":[\"scope\",\"missing child\"]},\"hermes\":{\"warnings\":[\"missing parent\"]}},\"errors\":{\"codex\":\"database locked\",\"hermes\":\"invalid file\"}}"))
         (notices (agent-dash-hub--backup-notices reply "exited abnormally")))
    (dolist (detail '("dsh 提示：scope" "dsh 提示：missing child" "hermes 提示：missing parent"
                      "codex 错误：database locked" "hermes 错误：invalid file"))
      (should (string-search detail notices)))
    (should-not (string-search "exited abnormally" notices))))

(ert-deftest agent-dash-backup-hermes-home-and-export-all ()
  (let ((agent-dash-hermes-directory "/tmp/custom-hermes/") args)
    (should (equal (agent-dash-hub--backup-homes '(hermes))
                   '("--home" "hermes" "/tmp/custom-hermes/")))
    (cl-letf (((symbol-function 'agent-dash-hub--backup-rows)
               (lambda (selected)
                 (should-not selected)
                 '((:backend hermes :id "a" :key "hermes:a"))))
              ((symbol-function 'read-directory-name) (lambda (&rest _) temporary-file-directory))
              ((symbol-function 'agent-dash-hub--backup-run) (lambda (a _done) (setq args a))))
      (agent-dash-hub-backup-export-all)
      (should (member "hermes:a" args))
      (should (member "/tmp/custom-hermes/" args)))))

(provide 'agent-dash-backup-test)
;;; agent-dash-backup-test.el ends here
