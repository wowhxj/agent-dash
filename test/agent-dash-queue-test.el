(ert-deftest agent-dash-queue-test-protocol-acknowledgements-without-images ()
  (dolist (backend '(pi codex hermes))
    (agent-dash-queue-test-with-chat
     (setf (agent-dash-session-backend session) backend)
     (agent-dash-set-data session :sid "fixture-session")
     (let ((entry (agent-dash-queue-add session "plain text" nil)) callback)
       (cl-letf (((symbol-function 'agent-dash-pi--request)
                  (lambda (_s _message &optional cb) (setq callback cb)))
                 ((symbol-function 'agent-dash-holder-request)
                  (lambda (_s _method _params &optional cb) (setq callback cb)))
                 ((symbol-function 'agent-dash-holder-log) #'ignore))
         (agent-dash-queue--pump session))
       (should (functionp callback))
       (should (eq (plist-get entry :status) 'sending))
       ;; Completion may arrive before the command acknowledgement.
       (agent-dash-emit session '(:type run :state running))
       (agent-dash-emit session '(:type run :state idle))
       (should (agent-dash-data session :queue-inflight))
       (if (eq backend 'pi) (funcall callback t nil nil)
         (funcall callback (agent-dash-json-read "{\"stopReason\":\"end_turn\"}") nil))
       (should (eq (plist-get entry :status) 'sent))
       (should-not (agent-dash-data session :queue-inflight))))))

(ert-deftest agent-dash-queue-test-hermes-settled-response-still-closes-the-run ()
  (agent-dash-queue-test-with-chat
   (setf (agent-dash-session-backend session) 'hermes)
   (agent-dash-set-data session :sid "fixture")
   (let ((entry (agent-dash-queue-add session "hello" nil)) callback)
     (cl-letf (((symbol-function 'agent-dash-holder-request)
                (lambda (_s _method _params &optional cb) (setq callback cb)))
               ((symbol-function 'agent-dash-holder-log) #'ignore))
       (agent-dash-queue--pump session))
     (agent-dash-emit session '(:type run :state running))
     (cl-letf (((symbol-function 'agent-dash-holder-settle)
                (lambda (_s record)
                  (funcall callback (agent-dash-jget record "result") nil) t)))
       (agent-dash-hermes--record
        session
        (agent-dash-json-read "{\"id\":12,\"result\":{\"stopReason\":\"end_turn\"}}")))
     (should (eq (agent-dash-session-state session) 'idle))
     (should (eq (plist-get entry :status) 'sent)))))

(ert-deftest agent-dash-queue-test-claude-steer-waits-for-correlated-start ()
  (agent-dash-queue-test-with-chat
   (setf (agent-dash-session-backend session) 'claude)
   (agent-dash-emit session '(:type run :state running))
   (let* ((entry (agent-dash-queue-add session "change direction" nil 'steer))
          (id (plist-get entry :id)) written)
     (cl-letf (((symbol-function 'agent-dash-claude--control) #'ignore)
               ((symbol-function 'agent-dash-holder-write)
                (lambda (_s message) (setq written message))))
       (agent-dash-queue-apply session id))
     (should (eq (plist-get entry :status) 'sending))
     ;; The interrupted OLD run may still emit running/idle; do not drain follow-ups.
     (agent-dash-emit session '(:type run :state running))
     (agent-dash-emit session '(:type run :state idle))
     (should (equal (agent-dash-data session :queue-inflight) id))
     (agent-dash-claude--record
      session (agent-dash-json-read
               (json-serialize (list :type "command_lifecycle" :state "started"
                                     :command_uuid (plist-get written :uuid)))))
     (should (eq (plist-get entry :status) 'accepted))
     (should (plist-get entry :started))
     (agent-dash-emit session '(:type run :state idle))
     (should (eq (plist-get entry :status) 'sent)))))

(ert-deftest agent-dash-queue-test-dsh-queued-writes-disable-automatic-http-retry ()
