(ert-deftest agent-dash-queue-test-image-editor-lease-save-and-live-draft-isolation ()
  (agent-dash-queue-test-with-chat
   (cl-letf (((symbol-function 'agent-dash-capability) (lambda (_s _key) t)))
     (agent-dash--set-input "live draft")
     (setq agent-dash--attachments (list agent-dash-queue-test-image))
     (goto-char (+ agent-dash--input-start 3))
     (let* ((entry (agent-dash-queue-add session "queued draft" nil))
            (editor (save-window-excursion
                      (agent-dash-queue--edit session (plist-get entry :id)))))
       (unwind-protect
           (progn
             (agent-dash-queue--pump session)
             (should-not agent-dash-fake-calls)
             (should-error (agent-dash-queue-delete session (plist-get entry :id))
                           :type 'user-error)
             (with-current-buffer editor
               (should (eq (key-binding (kbd "C-c C-c")) #'agent-dash-queue-edit-save))
               (agent-dash--set-input "new queued text")
               (agent-dash-image--stage agent-dash-queue-test-image)
               (agent-dash-queue-edit-save))
             (should (equal (plist-get entry :text) "new queued text"))
             (should (equal (plist-get entry :images) (list agent-dash-queue-test-image)))
             (should-not (plist-get entry :editor))
             (should (equal (agent-dash--input) "live draft"))
             (should (equal agent-dash--attachments (list agent-dash-queue-test-image)))
             (should (= (point) (+ agent-dash--input-start 3))))
         (when (buffer-live-p editor)
           (with-current-buffer editor
             (let ((agent-dash-queue--saved t)) (kill-buffer)))))))))

