;;; agent-dash-queue-test.el --- Local queue acceptance -*- lexical-binding: t; -*-

;;; Commentary:
;; Offline queue, handoff, multimodal editor and backend protocol regressions.

;;; Code:
(require 'ert)
(require 'agent-dash)
(require 'agent-dash-fake)

(defconst agent-dash-queue-test-image
  (list :data (concat "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAD"
                      "UlEQVR42mP8/5+hHgAHggJ/PzWvWQAAAABJRU5ErkJggg==")
        :mime-type "image/png" :name "fixture.png"))
(defmacro agent-dash-queue-test-with-chat (&rest body)
  "Evaluate BODY in an isolated offline queue chat."
  (declare (indent 0) (debug t))
  `(let ((agent-dash-queue--sessions nil) (agent-dash--sessions nil)
         (agent-dash-prompt-filter-functions nil) (agent-dash-fake-calls nil))
     (let* ((session (agent-dash-session-create 'fake temporary-file-directory))
            (buffer (agent-dash--setup-buffer session)))
       (unwind-protect
           (cl-letf (((symbol-function 'agent-dash-queue--schedule) #'ignore))
             (with-current-buffer buffer ,@body))
         (when (buffer-live-p buffer)
           (with-current-buffer buffer
             (let ((agent-dash--quitting t)) (kill-buffer))))))))

(ert-deftest agent-dash-queue-test-order-edit-delete-convert-and-images ()
  (agent-dash-queue-test-with-chat
   (cl-letf (((symbol-function 'agent-dash-capability) (lambda (_s _key) t)))
     (let* ((images (list (copy-tree agent-dash-queue-test-image)))
            (one (agent-dash-queue-add session "one" images))
            (two (agent-dash-queue-add session "two" nil))
            (id (plist-get one :id)))
       (setf (plist-get (car images) :name) "changed outside")
       (should (equal (plist-get (car (plist-get one :images)) :name) "fixture.png"))
       (agent-dash-queue-move session (plist-get two :id) -1)
       (should (eq two (car (agent-dash-queue-pending session))))
       (agent-dash-queue-update session id "edited" (list agent-dash-queue-test-image))
       (should (equal (plist-get one :text) "edited"))
       (agent-dash-queue-convert session id 'steer)
       (should (eq (plist-get one :kind) 'steer))
       (should (agent-dash-data session :queue-paused))
       (should-not agent-dash-fake-calls)
       (agent-dash-queue-convert session id 'follow-up)
       (agent-dash-queue-delete session (plist-get two :id))
       (should (equal (agent-dash-queue-pending session) (list one)))))))

(ert-deftest agent-dash-queue-test-one-follow-per-whole-run ()
  (agent-dash-queue-test-with-chat
   (agent-dash-emit session '(:type run :state running))
   (let ((one (agent-dash-queue-add session "one" nil))
         (two (agent-dash-queue-add session "two" nil)))
     (agent-dash-queue--pump session)
     (should-not agent-dash-fake-calls)
     (agent-dash-emit session '(:type run :state idle))
     (agent-dash-queue--pump session)
     (should (equal (car agent-dash-fake-calls) '(send "one" nil prompt)))
     (should (eq (plist-get one :status) 'accepted))
     ;; An idle snapshot without a new run is not completion of this delivery.
     (agent-dash-emit session '(:type run :state idle))
     (agent-dash-queue--pump session)
     (should (= (length agent-dash-fake-calls) 1))
     (agent-dash-emit session '(:type run :state running))
     (agent-dash-emit session '(:type assistant :id "a" :text "intermediate" :final t))
     (agent-dash-queue--pump session)
     (should (= (length agent-dash-fake-calls) 1))
     (agent-dash-emit session '(:type run :state idle))
     (should (eq (plist-get one :status) 'sent))
     (agent-dash-queue--pump session)
     (should (equal (car agent-dash-fake-calls) '(send "two" nil prompt)))
     (should (eq (plist-get two :status) 'accepted))
     (should-error (agent-dash-queue-update session (plist-get one :id) "changed" nil)
                   :type 'user-error))))

(ert-deftest agent-dash-queue-test-steer-is-staged-and-image-payload-is-atomic ()
  (agent-dash-queue-test-with-chat
   (cl-letf (((symbol-function 'agent-dash-capability) (lambda (_s _key) t)))
     (agent-dash-emit session '(:type run :state running))
     (let* ((entry (agent-dash-queue-add session "look here" (list agent-dash-queue-test-image)
                                         'steer))
            (id (plist-get entry :id)))
       (agent-dash-queue--pump session)
       (should-not agent-dash-fake-calls)
       (agent-dash-queue-apply session id)
       (should (equal (car agent-dash-fake-calls)
                      (list 'send "look here" (list agent-dash-queue-test-image) 'steer)))
       (should-error (agent-dash-queue-apply session id) :type 'user-error)
       (should-error (agent-dash-queue-delete session id) :type 'user-error)
       (agent-dash-emit session '(:type run :state idle))
       (should (eq (plist-get entry :status) 'sent))
       (should (= (plist-get entry :image-count) 1))))))

(ert-deftest agent-dash-queue-test-ack-correlation-failure-and-no-retry ()
  (agent-dash-queue-test-with-chat
   (setf (agent-dash-session-backend session) 'pi)
   (let ((entry (agent-dash-queue-add session "first" nil)) callback)
     (agent-dash-queue-add session "second" nil)
     (cl-letf (((symbol-function 'agent-dash-pi--request)
                (lambda (_s _message &optional cb) (setq callback cb))))
       (agent-dash-queue--pump session))
     (should (eq (plist-get entry :status) 'sending))
     (agent-dash-delivery-result session "wrong-id" t)
     (should (eq (plist-get entry :status) 'sending))
     (agent-dash-emit session '(:type run :state running))
     (agent-dash-emit session '(:type run :state idle))
     (should (agent-dash-data session :queue-inflight))
     (funcall callback nil nil "rejected")
     (should (eq (plist-get entry :status) 'failed))
     (should (equal (plist-get entry :text) "first"))
     (should (agent-dash-data session :queue-paused))
     (agent-dash-queue--pump session)
     (should (eq (plist-get (car (agent-dash-queue-pending session)) :status) 'pending))
     ;; Late success cannot revive or retry the failed delivery.
     (funcall callback t nil nil)
     (should (eq (plist-get entry :status) 'failed)))))

