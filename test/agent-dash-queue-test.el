     (plist-put sent :status 'sent)
     (with-temp-buffer
       (agent-dash-queue-mode)
       (setq agent-dash-queue--owner session)
       (agent-dash-queue--render)
       (should-not (string-search "HIDDEN RECEIPT" (buffer-string)))
       (should-not (string-search "not reported" (buffer-string)))
       (should-not (string-search "cannot be changed" (buffer-string)))
       (should (string-match-p "Steer (1)" (buffer-string)))
       (should (string-match-p "Follow (1)" (buffer-string)))
       (should (equal (tabulated-list-get-id) (plist-get steer :id)))
       (agent-dash-queue-next)
       (should (equal (tabulated-list-get-id) (plist-get follow :id)))
       (agent-dash-queue-next)
       (should (equal (tabulated-list-get-id) (plist-get follow :id)))
       (agent-dash-queue-previous)
       (should (equal (tabulated-list-get-id) (plist-get steer :id)))
       (should (string-search "n/p select" header-line-format))
       (should (string-search "M-n/p move" header-line-format))
       (should (string-search "e edit" header-line-format))
       (should (string-search "x apply" (apply #'concat mode-line-format)))
       (should (eq (key-binding (kbd "p")) #'agent-dash-queue-previous))
       (should (eq (key-binding (kbd "M-n")) #'agent-dash-queue-down))
       (should (eq (key-binding (kbd "M-p")) #'agent-dash-queue-up))))))

(ert-deftest agent-dash-queue-test-boundary-moves-preserve-image-message-and-group-order ()
  (agent-dash-queue-test-with-chat
   (cl-letf (((symbol-function 'agent-dash-capability) (lambda (_s _key) t)))
     (let* ((s1 (agent-dash-queue-add session "s1" nil 'steer))
            (s2 (agent-dash-queue-add session "s2" nil 'steer))
            (f1 (agent-dash-queue-add session "f1" (list agent-dash-queue-test-image)))
            (f2 (agent-dash-queue-add session "f2" nil))
            (id (plist-get f1 :id))
            (images (plist-get f1 :images)))
       (agent-dash-queue-move session id -1)
       (should (equal (agent-dash-queue-pending session 'steer) (list s1 s2 f1)))
       (should (equal (agent-dash-queue-pending session 'follow-up) (list f2)))
       (should (eq images (plist-get f1 :images)))
       (agent-dash-queue-move session id 1)
       (should (equal (agent-dash-queue-pending session 'follow-up) (list f1 f2)))
       (agent-dash-queue-move session (plist-get s2 :id) 1)
       (should (equal (agent-dash-queue-pending session 'follow-up) (list s2 f1 f2)))
       (agent-dash-queue-move session (plist-get s2 :id) -1)
       (should (equal (agent-dash-queue-pending session 'steer) (list s1 s2)))
       (should (equal id (plist-get f1 :id)))
       (should (equal (plist-get f1 :wire-text) "f1"))
       (should (agent-dash-data session :queue-paused))
       (agent-dash-queue--pump session)
       (should-not agent-dash-fake-calls)))))

(ert-deftest agent-dash-queue-test-empty-group-crossing-and-unsupported-promotion ()
  (agent-dash-queue-test-with-chat
   (let* ((entry (agent-dash-queue-add session "move me" nil))
          (id (plist-get entry :id)))
     (agent-dash-queue-move session id -1)
     (should (equal (agent-dash-queue-pending session 'steer) (list entry)))
     (agent-dash-queue-move session id 1)
     (should (equal (agent-dash-queue-pending session 'follow-up) (list entry)))
     (agent-dash-queue-continue session)
     (setf (agent-dash-session-backend session) 'hermes)
     (should-error (agent-dash-queue-move session id -1) :type 'user-error)
     (should (eq (plist-get entry :kind) 'follow-up))
     (should-not (agent-dash-data session :queue-paused))
     (should-not agent-dash-fake-calls))))

(ert-deftest agent-dash-queue-test-hidden-success-receipts-do-not-block-new-entries ()
  (agent-dash-queue-test-with-chat
   (let ((agent-dash-queue-limit 1)
         (entry (agent-dash-queue-add session "old receipt" nil)))
     (plist-put entry :status 'sent)
     (let ((new (agent-dash-queue-add session "new entry" nil)))
       (should (equal (agent-dash-queue-entries session) (list new)))))))

(ert-deftest agent-dash-queue-test-composer-image-enqueue-clears-draft-once ()
  (dolist (command '(agent-dash-send agent-dash-steer))
    (dolist (text '("" "photo question"))
      (dolist (previous '(nil (:text "previous image submission")))
        (agent-dash-queue-test-with-chat
         (cl-letf (((symbol-function 'agent-dash-capability) (lambda (_s _key) t)))
           (agent-dash-emit session '(:type run :state running))
           (setq agent-dash--last-image-draft previous)
           (agent-dash--set-input text)
           (setq agent-dash--attachments (list agent-dash-queue-test-image))
           (funcall command)
           (should (equal (agent-dash--input) ""))
           (should-not agent-dash--attachments)
           (let ((entries (agent-dash-queue-pending session)))
             (should (= (length entries) 1))
             (should (equal (plist-get (car entries) :text) text))
             (should (equal (plist-get (car entries) :images)
                            (list agent-dash-queue-test-image))))
           (should-not agent-dash-fake-calls)
           (should-error (agent-dash-send) :type 'user-error)
           (should (= (length (agent-dash-queue-pending session)) 1))))))))

(ert-deftest agent-dash-queue-test-rejected-image-enqueue-keeps-whole-draft ()
  (agent-dash-queue-test-with-chat
   (cl-letf (((symbol-function 'agent-dash-capability) (lambda (_s _key) t)))
     (agent-dash-emit session '(:type run :state running))
     (agent-dash--set-input "keep photo draft")
     (setq agent-dash--attachments (list agent-dash-queue-test-image))
     (let ((agent-dash-queue-limit 0))
       (should-error (agent-dash-send) :type 'user-error))
     (should (equal (agent-dash--input) "keep photo draft"))
     (should (equal agent-dash--attachments (list agent-dash-queue-test-image)))
     (should-not (agent-dash-queue-pending session)))))

(ert-deftest agent-dash-queue-test-help-is-transient-and-does-not-send ()
  (agent-dash-queue-test-with-chat
   (agent-dash-queue-add session "queued" nil)
   (with-temp-buffer
     (agent-dash-queue-mode)
     (setq agent-dash-queue--owner session)
     (agent-dash-queue--render)
     (let (opened)
       (cl-letf (((symbol-function 'transient-setup)
                  (lambda (prefix &rest _) (setq opened prefix))))
         (call-interactively (key-binding (kbd "?"))))
       (should (eq opened 'agent-dash-queue-help))
       (should (get 'agent-dash-queue-help 'transient--prefix))
       (should (transient-get-suffix 'agent-dash-queue-help "M-n"))
       (should (transient-get-suffix 'agent-dash-queue-help "M-p"))
       (should (transient-get-suffix 'agent-dash-queue-help "x"))
       (should (= (length (agent-dash-queue-pending session)) 1))
       (should-not agent-dash-fake-calls)))))

